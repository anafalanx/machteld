From: Tcl upstream change 945ecf325f89212b1b29d30ce13c46cb24975dd8
Subject: Remove Windows symbolic links during recursive directory deletion
Upstream: https://github.com/tcltk/tcl/commit/945ecf325f89212b1b29d30ce13c46cb24975dd8

The two upstream source hunks are unchanged apart from line positions in 9.0.4.

--- a/tcl9.0.4/win/tclWinFCmd.c
+++ b/tcl9.0.4/win/tclWinFCmd.c
@@ -1068,6 +1068,16 @@ DoRemoveJustDirectory(
 	if (TclWinSymLinkDelete(nativePath, 0) == 0) {
 	    return TCL_OK;
 	}
+
+	/*
+	 * TclWinSymLinkDelete only handles junctions. RemoveDirectoryW
+	 * removes other links to directories too, but not their targets.
+	 * [Bug 08203e40e3]
+	 */
+
+	if (RemoveDirectoryW(nativePath) != FALSE) {
+	    return TCL_OK;
+	}
     } else {
 	/*
 	 * Ordinary directory.
@@ -1462,11 +1472,24 @@ TraversalDelete(
 	    return TCL_OK;
 	}
 	break;
-    case DOTREE_LINK:
-	if (DoRemoveJustDirectory(nativeSrc, 0, NULL) == TCL_OK) {
+    case DOTREE_LINK: {
+	DWORD attr = GetFileAttributesW(nativeSrc);
+
+	if (attr != INVALID_FILE_ATTRIBUTES
+		&& !(attr & FILE_ATTRIBUTE_DIRECTORY)) {
+	    /*
+	     * A symbolic link to a file: remove the link like a file.
+	     * [Bug 08203e40e3]
+	     */
+
+	    if (TclpDeleteFile(nativeSrc) == TCL_OK) {
+		return TCL_OK;
+	    }
+	} else if (DoRemoveJustDirectory(nativeSrc, 0, NULL) == TCL_OK) {
 	    return TCL_OK;
 	}
 	break;
+    }
     case DOTREE_PRED:
 	return TCL_OK;
     case DOTREE_POSTD:

{
  "id": "run_probe",
  "description": "Launch the injected native helper directly, capture its two UTF-8 streams, normalize completion or a fixed 200 ms timeout, and leave no live direct child.",
  "function": "run_probe",
  "arguments": [
    "helper",
    "mode",
    "payload"
  ],
  "helper_injected": true,
  "outputs": [
    "status",
    "exit",
    "out",
    "err"
  ],
  "timeout_ms": 200,
  "visible": [
    {
      "id": "visible_ok",
      "dimension": "completion",
      "mode": "ok",
      "payload": "hello world",
      "expected": [
        "ok",
        0,
        "hello world",
        "E:hello world"
      ]
    },
    {
      "id": "visible_fail",
      "dimension": "exit_and_arguments",
      "mode": "fail",
      "payload": "a\"b\\c & d",
      "expected": [
        "error",
        7,
        "a\"b\\c & d",
        "E:a\"b\\c & d"
      ]
    },
    {
      "id": "visible_timeout",
      "dimension": "timeout_cleanup",
      "mode": "hang",
      "payload": "ignored",
      "expected": [
        "timeout",
        -1,
        "",
        ""
      ]
    }
  ],
  "hidden": [
    {
      "id": "empty_payload",
      "dimension": "argument_and_capture",
      "mode": "ok",
      "payload": "",
      "expected": [
        "ok",
        0,
        "",
        "E:"
      ]
    },
    {
      "id": "unicode_success",
      "dimension": "unicode",
      "mode": "ok",
      "payload": "café 日本",
      "expected": [
        "ok",
        0,
        "café 日本",
        "E:café 日本"
      ]
    },
    {
      "id": "shell_metacharacters",
      "dimension": "argument_safety",
      "mode": "fail",
      "payload": "<&|^ %PATH%",
      "expected": [
        "error",
        7,
        "<&|^ %PATH%",
        "E:<&|^ %PATH%"
      ]
    },
    {
      "id": "large_payload",
      "dimension": "capture",
      "mode": "ok",
      "payload": "",
      "expected": [
        "ok",
        0,
        "",
        "E:"
      ]
    },
    {
      "id": "unicode_failure",
      "dimension": "unicode_and_exit",
      "mode": "fail",
      "payload": "Grüße 日本 \"雪\" \\ 🙂",
      "expected": [
        "error",
        7,
        "Grüße 日本 \"雪\" \\ 🙂",
        "E:Grüße 日本 \"雪\" \\ 🙂"
      ]
    },
    {
      "id": "timeout_cleanup",
      "dimension": "timeout_cleanup",
      "mode": "hang",
      "payload": "still ignored",
      "expected": [
        "timeout",
        -1,
        "",
        ""
      ]
    }
  ]
}

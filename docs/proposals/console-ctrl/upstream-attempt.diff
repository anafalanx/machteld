diff --git a/test/process_test.tcl b/test/process_test.tcl
index 4a8ba4b..8222a5f 100644
--- a/test/process_test.tcl
+++ b/test/process_test.tcl
@@ -369,6 +369,72 @@ if {[info exists ::env(MACHTELD_TEST_PTY_IO)] && $::env(MACHTELD_TEST_PTY_IO) eq
     catch {pty close $repl}
 }
 
+# ---- console ctrl: who answers Ctrl-C when a child shares the console ----
+# The OS-level effect (the host surviving a CTRL_C_EVENT that the child
+# handles) cannot be exercised hermetically without a private console, so the
+# gate pins the verb's contract: exact arity, the two modes, the readable
+# state, and that the state actually round-trips through the OS call.
+check "console ctrl reports default before any change" [expr {
+    [console ctrl] eq "default"}]
+check "console ctrl ignore is applied and reported" [expr {
+    [console ctrl ignore] eq "ignore" && [console ctrl] eq "ignore"}]
+check "console ctrl default restores and reports" [expr {
+    [console ctrl default] eq "default" && [console ctrl] eq "default"}]
+check "console ctrl rejects an unknown mode" [expr {
+    [errcode_of {console ctrl sometimes}] eq {MACHTELD CONSOLE badvalue}}]
+check "console ctrl has exact arity" [expr {
+    [errcode_of {console ctrl ignore extra}] eq {MACHTELD CONSOLE usage}}]
+check "console rejects an unknown subcommand" [expr {
+    [errcode_of {console tone}] eq {MACHTELD CONSOLE usage}}]
+check "console requires a subcommand" [expr {
+    [errcode_of {console}] eq {MACHTELD CONSOLE usage}}]
+# A child launched while the host ignores Ctrl-C inherits that disposition;
+# the fixture's environment probe is a cheap way to launch one and confirm the
+# host is still fully functional afterwards.
+console ctrl ignore
+set result [run -- $FIXTURE ok payload]
+console ctrl default
+check "run still works while console ctrl is ignore" [expr {
+    [dict get $result status] eq "ok" && [dict get $result exit] == 0}]
+
+# ---- captured children never get a console window ----
+# A console child whose parent has no console is handed a NEW, VISIBLE console
+# window unless CreateProcess is told otherwise; a harness run from a hidden
+# shell used to pop one empty terminal per captured launch. The fixture reports
+# the console it was given: whether its window is visible, and whether the host
+# (the PID passed in) is attached to the same console. A captured launch must
+# answer "no visible window, not shared", which catches a launcher that omits
+# CREATE_NO_WINDOW either way: it shares the host's console when the host has
+# one, and pops a fresh visible window when it has none. (With Windows Terminal
+# as the default terminal a fresh console reports only its hidden pseudo-window,
+# so the visibility probe is weaker there; the sharing probe still holds
+# whenever the host has a console.)
+proc console_report {text} {
+    if {![regexp {CONSOLE hwnd=(\d+) visible=(\d+) shared=(\d+) procs=(\d+)} \
+            $text -> hwnd visible shared procs]} { return {} }
+    return [dict create hwnd $hwnd visible $visible shared $shared procs $procs]
+}
+proc console_hidden {report} {
+    expr {$report ne "" && ![dict get $report visible] && ![dict get $report shared]}
+}
+set result [run -- $FIXTURE console-window [pid]]
+check "captured run child reports its console" [expr {
+    [dict get $result status] eq "ok" && [console_report [dict get $result out]] ne ""}]
+check "captured run child has no visible window and no share of the host console" \
+    [console_hidden [console_report [dict get $result out]]]
+set token [child start -- $FIXTURE console-window [pid]]
+set result [child wait $token -timeout 5s]
+child close $token
+check "child start child has no visible window and no share of the host console" \
+    [console_hidden [console_report [dict get $result out]]]
+set console_file [file join $WORK detach-console.txt]
+if {![catch {detach -- $FIXTURE console-window [pid] $console_file}]} {
+    check "detached process reports its console" [wait_for_file $console_file]
+    check "detached process has no visible window and no share of the host console" \
+        [console_hidden [console_report [expr {
+            [file exists $console_file] ? [slurp $console_file] : ""}]]]
+}
+
 file delete -force $WORK
 if {$fails} {
     puts stderr "$fails process test(s) failed"

+/* Report the console this process was given: whether it has a window, whether
+ * that window is visible, and whether the named parent PID is attached to the
+ * same console. A captured launch must answer "no visible window, not shared".
+ * A launcher that omits CREATE_NO_WINDOW is caught either way: the child shares
+ * the host's console when the host has one, and pops a fresh visible window
+ * when the host has none. The report goes to stdout, or to a file when the
+ * launch has no stdout worth reading (detach). */
+static int console_window_report(const wchar_t *parent_text, const wchar_t *path) {
+    DWORD parent = milliseconds(parent_text);
+    if (parent == UINT32_MAX) {
+        return EXIT_USAGE;
+    }
+    HWND window = GetConsoleWindow();
+    int visible = window != NULL && IsWindowVisible(window) ? 1 : 0;
+
+    DWORD stack_list[64];
+    DWORD *list = stack_list;
+    DWORD count = GetConsoleProcessList(list, 64);
+    if (count > 64) {
+        list = (DWORD *)calloc(count, sizeof(DWORD));
+        if (list == NULL) {
+            return EXIT_OUTPUT;
+        }
+        DWORD again = GetConsoleProcessList(list, count);
+        count = again > count ? 0 : again;
+    }
+    int shared = 0;
+    for (DWORD index = 0; index < count; index++) {
+        if (list[index] == parent) {
+            shared = 1;
+        }
+    }
+    if (list != stack_list) {
+        free(list);
+    }
+
+    char text[96];
+    int length = snprintf(text, sizeof(text),
+                          "CONSOLE hwnd=%d visible=%d shared=%d procs=%lu\n",
+                          window != NULL ? 1 : 0, visible, shared,
+                          (unsigned long)count);
+    if (length <= 0 || (size_t)length >= sizeof(text)) {
+        return EXIT_OUTPUT;
+    }
+    if (path == NULL || path[0] == L'\0') {
+        return write_all(GetStdHandle(STD_OUTPUT_HANDLE), text, (DWORD)length)
+                   ? 0
+                   : EXIT_OUTPUT;
+    }
+    HANDLE file = CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ, NULL,
+                              CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) {
+        return EXIT_PIDFILE;
+    }
+    int ok = write_all(file, text, (DWORD)length) && FlushFileBuffers(file);
+    if (!CloseHandle(file)) {
+        ok = 0;
+    }
+    return ok ? 0 : EXIT_PIDFILE;
+}

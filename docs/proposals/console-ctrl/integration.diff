diff --git a/runtime/test/process_test.tcl b/runtime/test/process_test.tcl
index 7973ada..8f506bd 100644
--- a/runtime/test/process_test.tcl
+++ b/runtime/test/process_test.tcl
@@ -329,6 +329,34 @@ if {[info exists ::env(MT_TEST_PTY_IO)] && $::env(MT_TEST_PTY_IO) eq "1"} {
     catch {pty close $repl}
 }
 
+# ---- console ctrl: who answers Ctrl-C when a child shares the console ----
+# The OS-level effect (the host surviving a CTRL_C_EVENT that the child
+# handles) cannot be exercised hermetically without a private console, so the
+# gate pins the verb's contract: exact arity, the two modes, the readable
+# state, and that the state actually round-trips through the OS call.
+check "console ctrl reports default before any change" [expr {
+    [console ctrl] eq "default"}]
+check "console ctrl ignore is applied and reported" [expr {
+    [console ctrl ignore] eq "ignore" && [console ctrl] eq "ignore"}]
+check "console ctrl default restores and reports" [expr {
+    [console ctrl default] eq "default" && [console ctrl] eq "default"}]
+check "console ctrl rejects an unknown mode" [expr {
+    [errcode_of {console ctrl sometimes}] eq {MT CONSOLE badvalue}}]
+check "console ctrl has exact arity" [expr {
+    [errcode_of {console ctrl ignore extra}] eq {MT CONSOLE usage}}]
+check "console rejects an unknown subcommand" [expr {
+    [errcode_of {console tone}] eq {MT CONSOLE usage}}]
+check "console requires a subcommand" [expr {
+    [errcode_of {console}] eq {MT CONSOLE usage}}]
+# A child launched while the host ignores Ctrl-C inherits that disposition;
+# the fixture's environment probe is a cheap way to launch one and confirm the
+# host is still fully functional afterwards.
+console ctrl ignore
+set result [run -- $FIXTURE ok]
+console ctrl default
+check "run still works while console ctrl is ignore" [expr {
+    [dict get $result status] eq "ok" && [dict get $result exit] == 0}]
+
 file delete -force $WORK
 if {$fails} {
     puts stderr "$fails process test(s) failed"
